# === Backend — copia este archivo a backend/.env (dotenv; Vite NO lo lee) ===
# backend/.env esta ignorado por git. Aqui solo van nombres y valores falsos.

# Conexion local (desarrollo)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubs_bd
DB_USER=postgres
DB_PASSWORD=tu_password_local

# En produccion se usa DATABASE_URL (Supabase/Render) en vez de los DB_*.
# Pega aqui la cadena de conexion completa que te da el proveedor.
DATABASE_URL=

# Autenticacion: usa cadenas largas y aleatorias (no las versiones).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_jwt_secret
PORT=4000
ADMIN_CORREO=admin@ejemplo.com
ADMIN_SECRET=tu_admin_secret

# === Cloudinary (imagenes) ===
CLOUDINARY_URL=cloudinary://api_key_falsa:api_secret_falso@cloud_name_falso

# === CORS ===
CORS_ORIGIN=http://localhost:5173

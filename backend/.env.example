# === Backend — copia este archivo a backend/.env (dotenv; Vite NO lo lee) ===
# backend/.env esta ignorado por git. Aqui solo van nombres y valores falsos.

# Conexion local (desarrollo)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubs_bd
DB_USER=postgres
DB_PASSWORD=tu_password_local

# En produccion se usa DATABASE_URL (Supabase/Render) en vez de los DB_*.
# Pega aqui la cadena de conexion completa que te da el proveedor.
DATABASE_URL=

# === TLS con la base de datos remota ===
# Cuando existe DATABASE_URL, el backend exige TLS con verificacion de cadena
# e identidad del servidor (equivalente a sslmode=verify-full de libpq).
# - La cadena NO debe incluir los parametros ssl, sslmode, sslrootcert,
#   sslcert ni sslkey: el backend los rechaza al arrancar para que no
#   sobrescriban la configuracion segura (documentacion de node-postgres).
#   Si tu proveedor la entrega con "?sslmode=require", elimina ese trecho.
# - La validacion usa el almacen de confianza del sistema. Solo si el
#   proveedor usa una CA propia, declara una de estas dos fuentes (no ambas):
#   * DB_SSL_CA_PEM: el contenido PEM completo inline (recomendado en Render,
#     donde el disco es efimero y no hay como dejar un archivo estable).
#     Texto multilinea soportado por el panel de entornos de Render.
#   * DB_SSL_CA_FILE: la ruta a un archivo PEM de CA (desarrollo local).
# DB_SSL_CA_PEM=
# DB_SSL_CA_FILE=/ruta/a/ca-del-proveedor.pem
DB_SSL_CA_FILE=

# Autenticacion: usa cadenas largas y aleatorias (no las versiones).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_jwt_secret
PORT=4000
ADMIN_CORREO=admin@ejemplo.com
ADMIN_SECRET=tu_admin_secret

# === Rate limiting (H5a/H8) ===
# Los limites estan activos en TODOS los entornos (incluye desarrollo; el
# backend de desarrollo es publico). Solo sobrescribe si necesitas ajustar un
# umbral concreto; los valores por defecto son los seguros y positivos de
# lib/rateLimits.js. Cualquier valor invalido o negativo usa el default.
# RATE_LIMIT_GLOBAL_MINUTO=1200
# RATE_LIMIT_LOGIN_IP_15MIN=20
# RATE_LIMIT_LOGIN_CUENTA_15MIN=5
# RATE_LIMIT_MICROSOFT_15MIN=20
# RATE_LIMIT_REGISTRO_HORA=10
# RATE_LIMIT_ENCUESTAS_MINUTO=300
# RATE_LIMIT_FORMULARIOS_HORA=5
# RATE_LIMIT_UPLOAD_MINUTO=30
# RATE_LIMIT_NOTIFICACIONES_MINUTO=30
# RATE_LIMIT_LECTURAS_MINUTO=60
# En Render debe existir con valor "production" (H8). Si no está definida,
# los limites siguen activos; el valor solo afecta a otros comportamientos
# condicionados por NODE_ENV.

# === Acceso mediante código OTP (Fase 1.5) ===
# Desactivado por defecto. Los endpoints /api/auth/otp/* responden 503 mientras
# esta bandera no esté activa con el valor "true".
AUTH_OTP_ENABLED=false

# Secreto de servidor para el HMAC-SHA-256 de los códigos. Obligatorio cuando
# AUTH_OTP_ENABLED=true. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# No lo pongas en el frontend ni en el repositorio.
OTP_PEPPER=

# Vigencia del código en minutos (por defecto 10).
OTP_EXPIRATION_MINUTES=10

# Proveedor de correo OTP: "mock" (seguro por defecto, no envía correos),
# "resend" (API HTTPS, recomendado para Render Free) o "smtp" (solo
# compatibilidad; Render Free bloquea los puertos SMTP 25, 465 y 587).
OTP_MAIL_PROVIDER=mock

# Resend (API HTTPS). Para Render Free configura explícitamente:
#   OTP_MAIL_PROVIDER=resend
#   RESEND_API_KEY=tu_api_key_de_resend
#   RESEND_FROM=Clubs UNID <no-reply@tu-dominio-verificado>
# No pongas credenciales reales en este archivo.
RESEND_API_KEY=
RESEND_FROM=

# SMTP legado/opcional (solo se usa con OTP_MAIL_PROVIDER=smtp). No usar en
# Render Free. No pongas credenciales reales en este archivo.
# SMTP_USER y SMTP_PASSWORD deben configurarse juntos o dejarse ambos vacíos
# (relay interno sin autenticación).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Umbrales OTP (ventana de 15 minutos). Los intentos por código (5) se
# controlan además en la tabla otp_codigos.
# RATE_LIMIT_OTP_SOLICITUD_IP_15MIN=10
# RATE_LIMIT_OTP_SOLICITUD_CUENTA_15MIN=3
# RATE_LIMIT_OTP_VERIFICACION_IP_15MIN=20
# RATE_LIMIT_OTP_VERIFICACION_CUENTA_15MIN=10

# === Cloudinary (imagenes) ===
CLOUDINARY_URL=cloudinary://api_key_falsa:api_secret_falso@cloud_name_falso

# === CORS ===
CORS_ORIGIN=http://localhost:5173

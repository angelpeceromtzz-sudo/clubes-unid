# === Frontend (Vite) — raíz del repo ===
# Copia .env.example a .env (solo para overrides locales) y ajusta los modos en
# .env.development / .env.production. Sin secretos: prefijo VITE_ obligatorio.
VITE_PROXY_TARGET=http://localhost:4000
VITE_API_URL=
VITE_BACKEND_URL=

# === Backend — backend/.env (dotenv, NO lo lee Vite) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubs_bd
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=
PORT=4000
ADMIN_CORREO=
ADMIN_SECRET=

# === Cloudinary (imágenes) ===
CLOUDINARY_URL=cloudinary://<tu_api_key>:<tu_api_secret>@<tu_cloud_name>

# === CORS ===
CORS_ORIGIN=http://localhost:5173

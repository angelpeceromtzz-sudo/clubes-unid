# === Frontend (Vite) — raíz del repo ===
# Copia este archivo a .env.local y ajusta lo que necesites para desarrollo.
# En Vercel define estas variables en el panel (Project > Settings > Environment
# Variables). NUNCA pongas secretos aquí: todo lo que empieza por VITE_ queda
# expuesto en el bundle que descarga el navegador.
VITE_PROXY_TARGET=http://localhost:4000
VITE_API_URL=/api
VITE_BACKEND_URL=
VITE_PUBLIC_URL=
# Tercera opción de acceso con código institucional. Ponla en true solo si el
# backend tiene AUTH_OTP_ENABLED=true y la migración OTP ya fue aplicada.
VITE_AUTH_OTP_ENABLED=false

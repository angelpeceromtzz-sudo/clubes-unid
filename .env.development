# Modo desarrollo (`pnpm dev`).
# Sobrescribe .env

# Relativa a proposito: la resuelve el proxy de vite.config.js hacia VITE_PROXY_TARGET.
# Gracias a esto no hay CORS en desarrollo y el codigo es identico entre entornos.
VITE_API_URL=/api

# DEBE quedar vacio (NO "/"), para que obtenerUrlImagen devuelva "/uploads/..." y
# esa ruta viaje por el proxy. Si se pone "/" se generaria "//uploads/..." y el
# navegador lo interpretaria como una URL protocol-relative.
VITE_BACKEND_URL=

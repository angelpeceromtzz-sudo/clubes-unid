# Modo produccion (`pnpm build` -> Vercel).
# Sobrescribe .env
#
# Estos valores se hornean en el bundle en tiempo de BUILD: cambiar la URL exige
# rebuild, no basta con redeploy.
#
# La URL no es un secreto, por eso este archivo se versiona y el build de Vercel
# funciona sin configurar nada en el panel.

VITE_API_URL=https://clubes-unid.onrender.com/api

# Origen sin /api: se concatena con rutas que ya empiezan por /uploads
VITE_BACKEND_URL=https://clubes-unid.onrender.com
